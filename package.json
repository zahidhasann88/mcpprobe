{
  "name": "@zahid15/mcpprobe",
  "version": "0.1.0",
  "description": "Safety-first scripted testing and fuzzing for MCP servers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zahidhasann88/mcpprobe.git"
  },
  "homepage": "https://github.com/zahidhasann88/mcpprobe#readme",
  "bugs": "https://github.com/zahidhasann88/mcpprobe/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "fuzzing",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.7",
  "bin": {
    "mcpprobe": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "mcpprobe.config.example.yaml"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "fast-check": "^4.3.0",
    "json-schema-faker": "0.5.9",
    "shell-quote": "^1.8.3",
    "uri-template": "^2.0.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/shell-quote": "^1.7.5",
    "eslint": "^9.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
